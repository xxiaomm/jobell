# Postgres
POSTGRES_USER=jobell
POSTGRES_PASSWORD=jobell
POSTGRES_DB=jobell
DATABASE_URL=postgresql+psycopg2://jobell:jobell@postgres:5432/jobell

# Redis
REDIS_URL=redis://redis:6379/0
NEW_JOBS_CHANNEL=new_jobs

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email (MailHog by default for local dev; swap for a real SMTP provider in prod)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=jobs@jobell.local

# Frontend
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
